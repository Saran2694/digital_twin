<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="10dp">
        <com.datamint.twin.FactoryMapView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView style="@style/H3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live Equipment Monitoring" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
